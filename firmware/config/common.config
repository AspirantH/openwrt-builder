# common base for every build
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

# initramfs is left at the upstream default on purpose. For every router here it
# is the ONLY way in: their sysupgrade images are 'sysupgrade-tar', which no
# bootloader can write to flash, so a first install must tftp an initramfs image
# and run sysupgrade from the OpenWrt it boots. Targets opting out say so in
# their own overlay (see x86.config).

# third-party plugins every build gets; packages.ini clones their repos.
# Anything only some builds have room for goes in firmware/config/<name>.config instead.
#
# the packages.ini collection. Every build is x86 with a 1 GB
# rootfs, so flash size no longer picks the scope. The binary packages are
# prebuilt downloads (Build/Compile empty upstream), so they compile in
# seconds; their luci apps depend on them either way, spelled out here so a
# rename upstream fails the guard instead of vanishing.
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_btrfs_progs=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_lsblk=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-footstrap-files=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-openlist=y
CONFIG_PACKAGE_openlist=y
CONFIG_PACKAGE_luci-app-oui=y
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-vantage=y
CONFIG_PACKAGE_luci-app-verysync=y
CONFIG_PACKAGE_verysync=y
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-app-wechatpush_Local_Disk_Information_Detection=y
CONFIG_PACKAGE_luci-app-wechatpush_Host_Information_Detection=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-theme-carbon=y

# official feed
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_ariang=y
CONFIG_PACKAGE_luci-app-banip=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-uhttpd=y

# ocl deps
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y

# compression kernel modules
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_PACKAGE_kmod-lib-zstd=y


CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y

# utilities
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_bzip2=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_script-utils=y

# opbox dps
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-veth=y

# disk & system stack, carried over from the old repo's DEFAULT_PACKAGES
# injection: x86 with samba4/aria2/diskman actually mounting disks. NVMe is a
# MODULE on x86 (AHCI is built in, NVMe is not) — without it the boot disk has
# no driver at all. shadow-useradd backs samba4's user management.
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_mdadm=y
CONFIG_PACKAGE_smartd=y
CONFIG_PACKAGE_shadow-utils=y
CONFIG_PACKAGE_shadow-useradd=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_resolveip=y
