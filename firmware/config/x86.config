CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_IMAGES_GZIP=y

# x86 installs by writing a whole disk, so there is no "boot something temporary
# first" step: its initramfs product is just a bzImage with the rootfs inlined,
# useful only for netboot. The routers need the opposite (see common.config).
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# Image formats. Only two artifacts ship: the UEFI whole-disk image (gzipped)
# and the bootable ISO. GRUB_EFI_IMAGES / TARGET_IMAGES_GZIP already default to
# y upstream and are written out anyway as the record of what we ship. The
# other variants are explicitly off: legacy BIOS (CONFIG_GRUB_IMAGES, seabios
# boots) and the ext4 rootfs variant (CONFIG_TARGET_ROOTFS_EXT4FS, resizable
# root) would each add an image nobody here boots.
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_GRUB_IMAGES=n
CONFIG_TARGET_ROOTFS_EXT4FS=n
# bootable install media (built from the EFI GRUB image)
CONFIG_ISO_IMAGES=y
# don't wait in the GRUB menu; no VGA console text backend (headless box)
CONFIG_GRUB_TIMEOUT="0"
CONFIG_GRUB_CONSOLE=n

CONFIG_PACKAGE_kmod-amazon-ena=n
CONFIG_PACKAGE_kmod-amd-xgbe=n
CONFIG_PACKAGE_kmod-bnx2=n
CONFIG_PACKAGE_kmod-r8169=n
CONFIG_PACKAGE_bnx2-firmware=n
CONFIG_PACKAGE_r8169-firmware=n
CONFIG_PACKAGE_kmod-forcedeth=n
CONFIG_PACKAGE_kmod-iavf=n
CONFIG_PACKAGE_kmod-igb=n
CONFIG_PACKAGE_kmod-igbvf=n
CONFIG_PACKAGE_kmod-ixgbe=n
CONFIG_PACKAGE_kmod-ixgbevf=n
CONFIG_PACKAGE_kmod-nls-cp437=n
CONFIG_PACKAGE_kmod-nls-cp932=n
CONFIG_PACKAGE_kmod-nls-cp950=n
CONFIG_PACKAGE_kmod-nls-iso8859-1=n
CONFIG_PACKAGE_kmod-pcs-xpcs=n
CONFIG_PACKAGE_kmod-tg3=n
CONFIG_PACKAGE_zram-swap=n

CONFIG_PACKAGE_wireguard-tools=n
CONFIG_PACKAGE_kmod-wireguard=n
CONFIG_PACKAGE_luci-proto-wireguard=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_openssh-sftp-server=n
CONFIG_PACKAGE_luci-app-wifihistory=n

# no VMDK: PVE/KVM import the .img directly and VirtualBox converts on its own,
# while VMDK is uncompressed and the bulkiest of the lot. Add CONFIG_VMDK_IMAGES=y
# if an ESXi host ever needs it.

# rootfs tarballs are not flashable on their own
CONFIG_TARGET_ROOTFS_TARGZ=n
